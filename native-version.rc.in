#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
#ifdef XM6_KERNEL_BINARY
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
#else
 FILETYPE VFT_APP
 FILESUBTYPE 0
#endif
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "ProductName", "XM6 Audio\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
   VALUE "FileDescription", "XM6 Audio native Windows Bluetooth prototype\0"
   VALUE "LegalCopyright", "XM6 Audio and OpenA2DP contributors; third-party notices apply\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
