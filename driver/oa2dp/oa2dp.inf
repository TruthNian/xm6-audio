;
; oa2dp.inf — OpenA2DP Bluetooth A2DP transport driver
;
; Matches the A2DP Audio Sink service node (UUID 0x110B) that BTHENUM
; creates for every paired headset. Windows keeps its own (Microsoft-signed)
; driver as the automatic choice; oa2dpctl.exe selects this driver for one
; device at a time with DiInstallDevice, and restores Windows' driver the
; same way.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Bluetooth
ClassGuid   = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider    = %ProviderName%
CatalogFile = oa2dp.cat
DriverVer   = 11/08/2026,0.3.16.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
oa2dp.sys = 1
oa2dpsvc.exe = 1
oa2dpctl.exe = 1
ldac.dll = 1
sbc.dll = 1

[Manufacturer]
%ProviderName% = OpenA2DP, NTamd64.10.0...19041, NTarm64.10.0...19041

[OpenA2DP.NTamd64.10.0...19041]
%DeviceDesc% = Oa2dp_Install, BTHENUM\{0000110b-0000-1000-8000-00805f9b34fb}

[OpenA2DP.NTarm64.10.0...19041]
%DeviceDesc% = Oa2dp_Install, BTHENUM\{0000110b-0000-1000-8000-00805f9b34fb}

[Oa2dp_Install.NT]
CopyFiles = Oa2dp_CopyFiles

[Oa2dp_CopyFiles]
oa2dp.sys
oa2dpsvc.exe
oa2dpctl.exe
ldac.dll
sbc.dll

[Oa2dp_Install.NT.HW]
AddReg = Oa2dp_HW_AddReg

[Oa2dp_HW_AddReg]
; PnP applies this ACL to the device stack; driver.c keeps its FDO unnamed.
; LOCAL SERVICE opens only the bounded native AVRCP volume reference string.
; The transport control open still checks SYSTEM/admin and one owner in code.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;LS)"

[Oa2dp_Install.NT.Services]
AddService = oa2dp, 0x00000002, Oa2dp_Service
AddService = oa2dpsvc, 0, Oa2dp_CodecService

[Oa2dp_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\oa2dp.sys

[Oa2dp_CodecService]
DisplayName   = %CodecServiceDesc%
Description   = %CodecServiceDescription%
ServiceType   = 0x10            ; SERVICE_WIN32_OWN_PROCESS
StartType     = 3               ; start on native transport interface arrival
ErrorControl  = 1
ServiceBinary = %13%\oa2dpsvc.exe
AddTrigger    = Oa2dp_CodecTrigger

[Oa2dp_CodecTrigger]
TriggerType = 1                 ; SERVICE_TRIGGER_TYPE_DEVICE_INTERFACE_ARRIVAL
Action      = 1                 ; SERVICE_TRIGGER_ACTION_SERVICE_START
SubType     = %NativeTransportInterface%

[Oa2dp_Install.NT.Wdf]
KmdfService = oa2dp, Oa2dp_WdfSection

[Oa2dp_WdfSection]
KmdfLibraryVersion = 1.15

[Strings]
ProviderName = "XM6 Audio Project"
DiskName     = "XM6 Audio Driver Package"
DeviceDesc   = "XM6 Audio Bluetooth Audio Transport"
ServiceDesc  = "XM6 Audio Bluetooth A2DP Transport"
CodecServiceDesc = "XM6 Audio Native Codec Service"
CodecServiceDescription = "Audio codecs for the native Windows Bluetooth headphone endpoint."
NativeTransportInterface = "{8EF6C0BE-1B48-409A-A689-9F9FD9E82E12}"
